rules_version = '2';

// ===============================================================
// Data model — Carnet (Duolingo French study companion)
// ===============================================================
//
// /users/{uid}                    profile
//   streak: number, lastStudyDate: string (YYYY-MM-DD),
//   totalReviews: number, updatedAt: number
//
// /users/{uid}/words/{wordId}     saved vocabulary + spaced-repetition state
//   french, english, partOfSpeech, gender, pronunciation, memoryTip,
//   exampleFr, exampleEn, grammarNote, lookAlikes, tag, source: string
//   interval, repetition, easeFactor, lapses, nextReviewAt,
//   createdAt, updatedAt: number
//
// /users/{uid}/mistakes/{mistakeId}   explained Duolingo mistakes
//   prompt, myAnswer, correctAnswer, kind, headline, explanation,
//   rule, memoryTip: string
//   differences, practice, wordsToSave: list (bounded)
//   createdAt: number
//
// /users/{uid}/verbCells/{cellId}   Verb Lab: SRS state for one verb form
//   verb, tense: string, person: 0–5, interval, repetition, easeFactor,
//   lapses, nextReviewAt, correct, wrong, createdAt, updatedAt: number
//
// /users/{uid}/meta/verbLab          Verb Lab settings
//   myVerbs: list<string>, tenses: list<string>, answerMode: string,
//   updatedAt: number
//
// /users/{uid}/meta/today            Today's session progress
//   date: string (YYYY-MM-DD), done: list<string>, updatedAt: number
//
// Every document is private to its owner. Anything else is denied.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function str(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function nonEmpty(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function num(v, lo, hi) {
      return v is number && v >= lo && v <= hi;
    }

    function millis(v) {
      return num(v, 0, 9999999999999);
    }

    function isValidProfile(d) {
      return d.keys().hasOnly(['streak', 'lastStudyDate', 'totalReviews', 'updatedAt']) &&
        num(d.get('streak', 0), 0, 100000) &&
        str(d.get('lastStudyDate', ''), 10) &&
        num(d.get('totalReviews', 0), 0, 100000000) &&
        millis(d.get('updatedAt', 0));
    }

    function isValidWord(d) {
      return d.keys().hasOnly([
          'french', 'english', 'partOfSpeech', 'gender', 'pronunciation',
          'memoryTip', 'exampleFr', 'exampleEn', 'grammarNote', 'lookAlikes',
          'tag', 'source', 'interval', 'repetition', 'easeFactor', 'lapses',
          'nextReviewAt', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll(['french', 'english', 'interval', 'repetition',
                         'easeFactor', 'nextReviewAt', 'createdAt', 'updatedAt']) &&
        nonEmpty(d.french, 300) &&
        nonEmpty(d.english, 300) &&
        d.get('partOfSpeech', 'other') in
          ['noun', 'verb', 'adjective', 'adverb', 'pronoun', 'preposition', 'phrase', 'other'] &&
        d.get('gender', 'none') in ['masculine', 'feminine', 'none'] &&
        str(d.get('pronunciation', ''), 300) &&
        str(d.get('memoryTip', ''), 1000) &&
        str(d.get('exampleFr', ''), 500) &&
        str(d.get('exampleEn', ''), 500) &&
        str(d.get('grammarNote', ''), 1000) &&
        str(d.get('lookAlikes', ''), 500) &&
        str(d.get('tag', ''), 80) &&
        d.get('source', 'manual') in ['lookup', 'mistake', 'manual'] &&
        num(d.interval, 0, 36500) &&
        num(d.repetition, 0, 100000) &&
        num(d.easeFactor, 1.0, 5.0) &&
        num(d.get('lapses', 0), 0, 100000) &&
        millis(d.nextReviewAt) &&
        millis(d.createdAt) &&
        millis(d.updatedAt);
    }

    function isValidMistake(d) {
      return d.keys().hasOnly([
          'prompt', 'myAnswer', 'correctAnswer', 'kind', 'headline',
          'explanation', 'rule', 'memoryTip', 'differences', 'practice',
          'wordsToSave', 'createdAt'
        ]) &&
        d.keys().hasAll(['myAnswer', 'correctAnswer', 'kind', 'headline', 'createdAt']) &&
        str(d.get('prompt', ''), 1000) &&
        nonEmpty(d.myAnswer, 1000) &&
        nonEmpty(d.correctAnswer, 1000) &&
        d.kind in ['acceptable', 'typo', 'accent', 'agreement', 'article', 'conjugation',
                   'word-order', 'vocabulary', 'missing-word', 'extra-word', 'other'] &&
        nonEmpty(d.headline, 500) &&
        str(d.get('explanation', ''), 2000) &&
        str(d.get('rule', ''), 500) &&
        str(d.get('memoryTip', ''), 1000) &&
        d.get('differences', []) is list && d.get('differences', []).size() <= 8 &&
        d.get('practice', []) is list && d.get('practice', []).size() <= 5 &&
        d.get('wordsToSave', []) is list && d.get('wordsToSave', []).size() <= 5 &&
        millis(d.createdAt);
    }

    function isValidVerbCell(d) {
      return d.keys().hasOnly([
          'verb', 'tense', 'person', 'interval', 'repetition', 'easeFactor',
          'lapses', 'nextReviewAt', 'correct', 'wrong', 'createdAt', 'updatedAt'
        ]) &&
        d.keys().hasAll(['verb', 'tense', 'person', 'interval', 'repetition', 'easeFactor', 'lapses',
                         'nextReviewAt', 'correct', 'wrong', 'createdAt', 'updatedAt']) &&
        nonEmpty(d.verb, 40) &&
        d.tense in ['present', 'passe-compose', 'futur-proche', 'imparfait', 'futur'] &&
        d.person is int && d.person >= 0 && d.person <= 5 &&
        num(d.interval, 0, 36500) &&
        num(d.repetition, 0, 100000) &&
        num(d.easeFactor, 1.0, 5.0) &&
        num(d.lapses, 0, 100000) &&
        num(d.correct, 0, 1000000) &&
        num(d.wrong, 0, 1000000) &&
        millis(d.nextReviewAt) &&
        millis(d.createdAt) &&
        millis(d.updatedAt);
    }

    function isValidVerbPrefs(d) {
      return d.keys().hasOnly(['myVerbs', 'tenses', 'answerMode', 'updatedAt']) &&
        d.myVerbs is list && d.myVerbs.size() <= 200 &&
        d.tenses is list && d.tenses.size() <= 5 &&
        d.answerMode in ['type', 'choose'] &&
        millis(d.updatedAt);
    }

    function isValidTodayPlan(d) {
      return d.keys().hasOnly(['date', 'done', 'updatedAt']) &&
        nonEmpty(d.date, 10) &&
        d.done is list && d.done.size() <= 3 &&
        millis(d.updatedAt);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
      allow delete: if isOwner(uid);

      match /words/{wordId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && wordId.size() <= 64 &&
          isValidWord(request.resource.data);
      }

      match /verbCells/{cellId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && cellId.size() <= 80 &&
          isValidVerbCell(request.resource.data);
      }

      match /meta/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && (
          (docId == 'verbLab' && isValidVerbPrefs(request.resource.data)) ||
          (docId == 'today' && isValidTodayPlan(request.resource.data)));
      }

      match /mistakes/{mistakeId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && mistakeId.size() <= 64 &&
          isValidMistake(request.resource.data);
      }
    }
  }
}
